APP_HOST=127.0.0.1
APP_PORT=8765
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Docker Compose host mapping; the container always listens on APP_PORT.
HOST_PORT=8765
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reject unexpected Host headers to reduce DNS-rebinding exposure.
ALLOWED_HOSTS=127.0.0.1,localhost
DATA_DIR=./data
UPLOAD_DIR=./uploads

# OpenAI-compatible text model. DeepSeek, Qwen, Ollama and similar gateways work here.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini

# Optional. If empty, PublishFlow creates a local key with owner-only permissions.
ENCRYPTION_KEY=
SCHEDULE_TIMEZONE=Asia/Shanghai
MIN_PUBLISH_INTERVAL_SECONDS=90
MAX_RETRIES=1
RETRY_DELAY_SECONDS=120

# Content compliance checks run before task creation and again before execution.
COMPLIANCE_ENABLED=true
COMPLIANCE_RULESET_VERSION=2026-11-26
# Container images disable real publishing because they do not include a visible browser.
PUBLISHING_ENABLED=true

# Video processing. Leave empty to use the bundled ffmpeg and system ffprobe.
FFMPEG_BIN=
FFPROBE_BIN=
MAX_VIDEO_UPLOAD_MB=4096
MAX_VIDEO_DURATION_SECONDS=14400
VIDEO_TRANSCODE_TIMEOUT_SECONDS=1800
VIDEO_UPLOAD_TIMEOUT_SECONDS=1800

# Optional OpenAI-compatible image generation for the media library.
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
